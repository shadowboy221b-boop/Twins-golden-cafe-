# Twin's Golden Cafe — Hostinger (Apache / LiteSpeed) rules for the static build.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always serve the site over HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One address for every page. www served the whole site a second time at
  # its own addresses — the canonical tag told Google which one counted, but
  # a crawler that has not finished reading the real site should not be
  # spending its visits reading a copy of it.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # The file behind every page is called index.html, and asking for it by
  # name reaches the same page at a second address. THE_REQUEST is what the
  # browser actually asked for, so this only answers a visitor who typed it —
  # the internal rewrite below still reaches the file without bouncing.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [L,R=301]

  # /menu/ answers as well as /menu, and the canonical tag on it already says
  # which of the two counts. Stripping the slash here would mean redirecting
  # requests for real directories, and mod_dir's own habit of putting the
  # slash back is how a site ends up in a redirect loop. Not worth it for a
  # second address nothing links to.

  # /menu and /menu/ both serve menu/index.html, without a visible redirect.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

# Unknown addresses get the site's own 404 page rather than the host's.
ErrorDocument 404 /404.html

# Hashed build files never change under the same name, so browsers may keep
# them for a year. HTML is always re-checked so updates show up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>
