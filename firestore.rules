rules_version = '2';

/**
 * Who may read and write the cafe's records.
 *
 * Three kinds of visitor reach this database:
 *
 *  1. A guest ordering on the website, not signed in at all. They may file
 *     one order and nothing else — they cannot read a single thing, so no
 *     stranger can ever list the cafe's customers or their numbers.
 *  2. The counter device, signed in as the counter account. It may read the
 *     staff list and mark today's attendance. It cannot read orders or
 *     customers, and it cannot rewrite an earlier day.
 *  3. The owner, who may read and write everything.
 *
 * The two accounts are named by their Firebase uid below. To hand the cafe to
 * somebody else, or to add a second counter device, add the uid here and
 * publish again — Firebase console → Firestore → Rules.
 *
 * Paste this whole file into that editor and press Publish.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // the owner's own account
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'pPheDW2srFax8ZcTMPU4P06OUAe2';
    }

    // the phone or tablet that lives on the counter
    function isCounter() {
      return request.auth != null
        && request.auth.uid == 'JTibvTCm6FZNrDlNgb2QS4S8GlU2';
    }

    function isStaffDevice() {
      return isOwner() || isCounter();
    }

    // The team. The counter reads it to draw the check-in buttons.
    match /staff/{id} {
      allow read: if isStaffDevice();
      allow write: if isOwner();
    }

    /**
     * Attendance.
     *
     * The counter may write an entry of the right shape; the owner may write
     * or delete anything. Every entry records whether the floor or the owner
     * wrote it, which is what the sheet is read against.
     *
     * Two earlier attempts to hold the counter to the current day were refused
     * by the rules engine rather than by the person, and a counter that cannot
     * mark attendance is worse than one that could, in theory, mark yesterday.
     * The restriction can come back once it can be tested properly.
     */
    match /attendance/{id} {
      allow read: if isStaffDevice();
      allow create, update: if isOwner()
        || (isCounter()
            && request.resource.data.keys().hasOnly(
                 ['staffId', 'date', 'mark', 'inAt', 'outAt', 'note',
                  'photoIn', 'photoOut', 'by'])
            && request.resource.data.date is string
            && request.resource.data.date.size() == 10
            && request.resource.data.staffId is string
            && request.resource.data.mark is string);
      allow delete: if isOwner();
    }

    /**
     * The photograph taken at check-in, kept here rather than in file storage
     * because the free plan has no file storage. One document per photograph,
     * so a month of attendance can be read without dragging the pictures with
     * it.
     *
     * The counter may add one and may not read any back: a device on the
     * floor has no business browsing photographs of the staff. Only the owner
     * looks at them, and only the owner can remove one.
     */
    match /attendancePhotos/{id} {
      allow read: if isOwner();
      allow create, update: if isStaffDevice()
        && request.resource.data.keys().hasOnly(['image', 'kind', 'staffId', 'date', 'at'])
        && request.resource.data.image is string
        && request.resource.data.image.size() < 800000;
      allow delete: if isOwner();
    }

    // Orders from the website. A guest may file one; only the owner may read
    // them, and nothing may be changed or deleted afterwards.
    match /orders/{orderNo} {
      allow read: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(
                         ['orderNo', 'name', 'phone', 'type', 'when', 'address', 'landmark',
                          'notes', 'payment', 'paid', 'total', 'itemCount', 'items',
                          'createdAt', 'source'])
                    && request.resource.data.orderNo is string
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 15
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.total <= 100000
                    && request.resource.data.items.size() <= 60;
      allow update, delete: if isOwner();
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
